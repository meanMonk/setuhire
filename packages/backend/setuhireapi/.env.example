# Copy to .env and edit. Kept in git as a reference.
PORT=3400
SERVICE_NAME=setuhireapi
DB_TYPE=postgres
DB_NAME=app_setuhireapi

# ------------------------------------------------------------------
# Mongo — ONE canonical URI, two targets:
#   local dev (brew mongod) : 127.0.0.1, no auth  (creds are ignored)
#   docker / VPS            : `mongo` on vaayu_db  (container name)
# After `sudo bash scripts/hosts-local.sh`, `mongo` -> 127.0.0.1 so the
# SAME `mongo:27017` URI works both in docker and via brew.
# ------------------------------------------------------------------
MONGODB_URI=mongodb://setuhireapi:change_me@mongo:27017/app_setuhireapi?authSource=app_setuhireapi

# Postgres (only when DB_TYPE=postgres)
#   local dev (docker compose infra) : 127.0.0.1:5432  |  docker/VPS: `postgres` on vaayu_db
PG_URI=postgres://setuhire:setuhire@127.0.0.1:5432/app_setuhireapi

# Auth — JWT signing secret (httpOnly cookie `token`)
JWT_SECRET=dev-secret-change-me

# MinIO (object storage for resumes + contract PDFs — never on disk)
# Local infra (docker-compose.infra.yml) reads MINIO_ROOT_USER/PASSWORD from the
# repo-root .env — keep MINIO_ACCESS_KEY/SECRET_KEY in sync with those.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=setuhire

# Anthropic (optional — deterministic fallback used when empty)
ANTHROPIC_API_KEY=

# Docs
OPENAPI_TITLE=setuhireapi API
